{
  "name": "dsh-session-title-regen",
  "version": "0.1.1",
  "description": "DSH plugin: adds \"AI 重新生成标题\" to the \"...\" overflow menu on each session row in the left workspace sidebar. Collects the session's last 10 user prompts from its persisted event log, calls the model the session last used (provider/model from its latest request/header fold), and applies the generated title after an editable preview.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-title"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyewyewye/dsh-session-title-regen.git"
  },
  "bugs": {
    "url": "https://github.com/wyewyewye/dsh-session-title-regen/issues"
  },
  "homepage": "https://github.com/wyewyewye/dsh-session-title-regen#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  },
  "compatibility": {
    "dshReleases": {
      "0.2.1-rc.3": "compatible"
    }
  }
}
